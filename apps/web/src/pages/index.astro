---
import { getCollection } from "astro:content";
import { ApiStatus } from "@/features/api-status";
import BaseLayout from "@/layouts/BaseLayout.astro";

const labs = (await getCollection("labs")).sort((a, b) => a.data.number - b.data.number);
---

<BaseLayout title="CSST106 Laboratory Experiments">
  <header>
    <h1>Laboratory Experiments</h1>
    <p>
      Seven activities from CSST106, Perception and Computer Vision. Each one runs its technique
      live on a sample or on your own image.
    </p>
    <ApiStatus client:load />
  </header>
  <ol class="lab-list">
    {
      labs.map((lab) => (
        <li>
          <a href={`/labs/${lab.data.number}`}>
            <span class="lab-number">Lab {lab.data.number}</span>
            <strong>{lab.data.title}</strong>
            <span class="lab-summary">{lab.data.summary}</span>
          </a>
        </li>
      ))
    }
  </ol>
</BaseLayout>

<style>
  header {
    max-width: 44rem;
    margin-bottom: var(--space-8);
  }
  h1 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
  }
  header p {
    margin: 0 0 var(--space-3);
  }
  .lab-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lab-list a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    height: 100%;
    box-sizing: border-box;
    padding: var(--space-4);
    color: inherit;
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .lab-list a:hover {
    border-color: var(--color-accent);
  }
  .lab-number {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .lab-summary {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
