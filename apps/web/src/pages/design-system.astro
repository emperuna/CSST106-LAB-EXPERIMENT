---
import { Showcase } from "@/features/design-system";
import BaseLayout from "@/layouts/BaseLayout.astro";
import appIconUrl from "@csst106/tokens/brand/reticle-app-icon.svg?url";
import logoDarkUrl from "@csst106/tokens/brand/reticle-logo-dark.svg?url";

const colors = [
  ["Background", "--color-bg"],
  ["Surface", "--color-surface"],
  ["Sunken", "--color-sunken"],
  ["Ink", "--color-text"],
  ["Muted", "--color-muted"],
  ["Hairline", "--color-border"],
  ["Control line", "--color-border-strong"],
  ["Image well", "--color-well"],
  ["Teal", "--color-accent"],
  ["Teal soft", "--color-accent-soft"],
  ["Success", "--color-success"],
  ["Danger", "--color-danger"],
];
const series = ["--series-1", "--series-2", "--series-3", "--series-4", "--series-5"];
---

<BaseLayout bare title="Design system | Reticle" description="The Reticle design system: tokens and shared components.">
  <main id="content" class="ds-page">
  <h1>Reticle</h1>
  <p>The design system behind this site: every token and shared component. Reticle has one theme, dark.</p>
  <div class="ds-block">
    <div class="ds-logos">
      <img src={logoDarkUrl} alt="Reticle logo" height="56" />
      <img src={appIconUrl} alt="Reticle app icon" width="56" height="56" />
      <img src={appIconUrl} alt="" width="32" height="32" />
      <img src={appIconUrl} alt="" width="16" height="16" />
    </div>
    <div class="swatches">
      {colors.map(([name, token]) => (
        <div>
          <div class="swatch" style={`background: var(${token})`} />
          <span>{name}</span>
          <code>{token}</code>
        </div>
      ))}
    </div>
    <div class="swatches series">
      {series.map((token, index) => (
        <div>
          <div class="swatch" style={`background: var(${token})`} />
          <span>Series {index + 1}</span>
        </div>
      ))}
    </div>
    <h1 class="type-display">Edge Detection</h1>
    <p>
      Geist Serif carries headings, Geist Sans carries explanations, and DM Mono carries every reading:{" "}
      <code>512 x 512 · uint8 · 100, 200</code>. <a href="/">A text link</a>
    </p>
    <Showcase client:visible />
  </div>
  </main>
</BaseLayout>

<style is:global>
  .ds-page {
    box-sizing: border-box;
    padding: var(--space-8);
  }
  @media (max-width: 52rem) {
    .ds-page {
      padding: var(--space-5) var(--space-4);
    }
  }
  .ds-block {
    margin: var(--space-8) calc(var(--space-8) * -1) 0;
    padding: var(--space-8);
    background: var(--color-bg);
  }
  .ds-block h2 {
    margin: 0 0 var(--space-5);
    font-size: var(--text-xl);
  }
  .ds-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }
  .ds-logos img:first-child {
    width: auto;
    max-width: 100%;
  }
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    font-size: var(--text-xs);
  }
  .swatches > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .swatch {
    height: 3.5rem;
    margin-bottom: var(--space-1);
    border: var(--hairline) solid var(--color-border);
    border-radius: var(--radius);
  }
  .swatches code {
    color: var(--color-muted);
  }
  .type-display {
    margin: var(--space-6) 0 var(--space-2);
    font-size: var(--text-3xl);
  }
  .ds-showcase {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }
  .ds-section h3 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
  }
  .ds-icons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ds-icons li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: 6.5rem;
    padding: var(--space-4) var(--space-2);
    font-size: var(--text-xs);
    background: var(--color-surface);
    border: var(--hairline) solid var(--color-border);
    border-radius: var(--radius);
  }
  .ds-icons .lucide {
    font-size: 1.5rem;
  }
  .ds-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .ds-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-8);
    align-items: start;
  }
  .ds-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  @media (max-width: 52rem) {
    .ds-block {
      margin-inline: calc(var(--space-4) * -1);
      padding: var(--space-5) var(--space-4);
    }
  }
</style>
