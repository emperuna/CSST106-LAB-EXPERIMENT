---
import "@csst106/tokens/tokens.css";
import "@reticle/ui/styles.css";
import logoDarkUrl from "@csst106/tokens/brand/reticle-logo-dark.svg?url";
import { getCollection } from "astro:content";

interface Props {
  title: string;
  description?: string;
  /** No sidebar or main element: the page brings its own main, header and footer. */
  bare?: boolean;
}

const {
  title,
  description = "CSST106 Perception and Computer Vision laboratory experiments.",
  bare = false,
} = Astro.props;
const labs = (await getCollection("labs")).sort((a, b) => a.data.number - b.data.number);
const current = Astro.url.pathname.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    {
      bare ? (
        <slot />
      ) : (
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href="/" aria-label="Reticle home">
          <img src={logoDarkUrl} alt="" width="149" height="36" />
        </a>
        <nav aria-label="Laboratory activities">
          <ol>
            {
              labs.map((lab) => {
                const href = `/labs/${lab.data.number}`;
                return (
                  <li>
                    <a href={href} aria-current={current === href ? "page" : undefined}>
                      <span class="number">{lab.data.number}</span>
                      {lab.data.title}
                    </a>
                  </li>
                );
              })
            }
          </ol>
        </nav>
      </aside>
      <main id="content">
        <slot />
      </main>
    </div>
      )
    }
    <script>
      // On phones the lab list scrolls sideways; keep the current lab in view.
      document
        .querySelector('.sidebar a[aria-current="page"]')
        ?.scrollIntoView({ block: "nearest", inline: "center" });
    </script>
  </body>
</html>

<style is:global>
  html {
    -webkit-text-size-adjust: 100%;
  }
  .skip-link {
    position: absolute;
    left: var(--space-2);
    top: -4rem;
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
  }
  .skip-link:focus {
    top: var(--space-2);
  }
  .shell {
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    min-height: 100vh;
  }
  .sidebar {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    box-sizing: border-box;
    overflow-y: auto;
    padding: var(--space-6) var(--space-3);
    border-right: 1px solid var(--color-border);
  }
  .brand {
    display: flex;
    flex-direction: column;
    padding: 0 var(--space-3) var(--space-5);
    color: inherit;
    text-decoration: none;
  }
  .brand img {
    display: block;
    width: auto;
    height: 2.25rem;
  }
  .sidebar ol {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sidebar nav a {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.3;
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius);
  }
  .sidebar nav a:hover {
    background: var(--color-sunken);
  }
  .sidebar nav a[aria-current="page"] {
    font-weight: 600;
    background: var(--color-sunken);
  }
  .sidebar nav a[aria-current="page"] .number {
    color: var(--color-text);
  }
  .number {
    flex: none;
    width: 1em;
    font-family: var(--font-mono);
    color: var(--color-muted);
  }
  main {
    min-width: 0;
    box-sizing: border-box;
    max-width: 82rem;
    padding: var(--space-8);
  }
  @media (max-width: 52rem) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
    }
    .sidebar {
      position: static;
      height: auto;
      padding: var(--space-3) var(--space-4);
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }
    .brand {
      padding: 0 0 var(--space-2);
    }
    .sidebar ol {
      flex-direction: row;
      overflow-x: auto;
      scrollbar-width: none;
      gap: var(--space-1);
      margin: 0 calc(var(--space-4) * -1);
      padding: 0 var(--space-4);
    }
    .sidebar li {
      flex: none;
    }
    .sidebar nav a {
      white-space: nowrap;
      padding: var(--space-2);
    }
    main {
      padding: var(--space-5) var(--space-4);
    }
  }
</style>
