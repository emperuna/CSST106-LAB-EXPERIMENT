---
import "@csst106/tokens/tokens.css";
import "@reticle/ui/styles.css";

interface Props {
  title: string;
  description?: string;
}

/** The document shell. Each page brings its own nav, main and footer. */
const { title, description = "CSST106 Perception and Computer Vision laboratory experiments." } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <slot />
  </body>
</html>

<style is:global>
  html {
    -webkit-text-size-adjust: 100%;
  }
  .skip-link {
    position: absolute;
    left: var(--space-2);
    top: -4rem;
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
  }
  .skip-link:focus {
    top: var(--space-2);
  }
  main {
    min-width: 0;
    box-sizing: border-box;
    max-width: 82rem;
    padding: var(--space-8);
  }
  @media (max-width: 52rem) {
    main {
      padding: var(--space-5) var(--space-4);
    }
  }
</style>
