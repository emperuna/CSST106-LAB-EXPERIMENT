---
/*
 * A lab page in the app shell: a narrow lab rail on the left (the mark, then the seven labs), a slim
 * top bar with the lab's title, the API status, the lab sheet and the stepper, then the bench (the
 * lab's island: controls grouped by procedure step, readouts and a large viewer). The sheet's notes
 * (Concepts, Procedure, ...) open in a drawer, so the page itself is just the bench.
 */
import { ArrowLeft, ArrowRight, BookOpen, X } from "@reticle/ui";
import mark from "@csst106/tokens/brand/reticle-mark-dark.svg?url";
import { getCollection, getEntry, render } from "astro:content";
import { ApiStatus } from "@/features/api-status";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  lab: number;
}

const entry = await getEntry("labs", String(Astro.props.lab));
if (!entry) throw new Error(`Missing content for Lab ${Astro.props.lab}`);
const { Content } = await render(entry);
const { number, title, week, objective, summary } = entry.data;
const labs = (await getCollection("labs")).sort((a, b) => a.data.number - b.data.number);
const index = labs.findIndex((lab) => lab.data.number === number);
const previous = labs[index - 1]?.data;
const next = labs[index + 1]?.data;
const pad = (value: number) => String(value).padStart(2, "0");
---

<BaseLayout title={`Lab ${number}: ${title} | Reticle`} description={summary}>
  <div class="lab-shell">
    <aside class="lab-rail">
      <a class="lab-rail-home" href="/" aria-label="Reticle, home">
        <img src={mark} alt="" width="28" height="28" />
      </a>
      <nav aria-label="Labs">
        <ol>
          {
            labs.map(({ data }) => (
              <li>
                <a
                  href={`/labs/${data.number}`}
                  aria-label={`Lab ${data.number}: ${data.title}`}
                  aria-current={data.number === number ? "page" : undefined}
                >
                  {pad(data.number)}
                  <span class="lab-rail-tip" aria-hidden="true">
                    {data.title}
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </aside>

    <div class="lab-main">
      <header class="lab-bar">
        <div class="lab-bar-title">
          <span class="lab-bar-number">Lab {pad(number)}</span>
          <h1>{title}</h1>
          <span class="lab-bar-week">{week}</span>
        </div>
        <div class="lab-bar-tools">
          <ApiStatus client:load />
          <button
            type="button"
            class="lab-sheet-toggle"
            popovertarget="lab-sheet"
            aria-label="Open the lab sheet"
          >
            <BookOpen aria-hidden="true" />
            <span class="lab-sheet-label">Lab sheet</span>
          </button>
          <nav class="lab-stepper" aria-label="Previous and next lab">
            {
              previous ? (
                <a href={`/labs/${previous.number}`} rel="prev" aria-label={`Previous: Lab ${previous.number}, ${previous.title}`}>
                  <ArrowLeft aria-hidden="true" />
                </a>
              ) : (
                <span aria-hidden="true">
                  <ArrowLeft />
                </span>
              )
            }
            {
              next ? (
                <a href={`/labs/${next.number}`} rel="next" aria-label={`Next: Lab ${next.number}, ${next.title}`}>
                  <ArrowRight aria-hidden="true" />
                </a>
              ) : (
                <span aria-hidden="true">
                  <ArrowRight />
                </span>
              )
            }
          </nav>
        </div>
      </header>

      <main id="content" class="lab-page">
        <p class="lab-objective">{objective}</p>
        <section class="lab-bench" aria-label="Try it">
          <slot />
        </section>
      </main>
      <aside id="lab-sheet" class="lab-sheet" popover aria-labelledby="lab-sheet-title">
        <div class="lab-sheet-head">
          <h2 id="lab-sheet-title">Lab sheet <span>Lab {pad(number)}</span></h2>
          <button
            type="button"
            class="lab-sheet-close"
            popovertarget="lab-sheet"
            popovertargetaction="hide"
            aria-label="Close the lab sheet"
          >
            <X aria-hidden="true" />
          </button>
        </div>
        <div class="lab-notes">
          <Content />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .lab-shell {
    --rail-w: 64px;
    --bar-h: 56px;
    display: grid;
    grid-template-columns: var(--rail-w) minmax(0, 1fr);
    min-height: 100svh;
  }

  /* Rail: the mark, then the seven labs as numbered keys. The current one is lit in teal. */
  .lab-rail {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100svh;
    box-sizing: border-box;
    background: var(--color-bg);
    border-right: var(--hairline) solid var(--color-border);
  }
  /* The mark sits in a cell as tall as the top bar, and its hairline continues the bar's, so the
     rail and the bar read as one frame around the page. */
  .lab-rail-home {
    display: grid;
    flex: none;
    place-items: center;
    box-sizing: border-box;
    width: 100%;
    height: var(--bar-h);
    border-bottom: var(--hairline) solid var(--color-border);
  }
  .lab-rail-home img {
    display: block;
    width: 28px;
    height: 28px;
  }
  .lab-rail ol {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-3) 0 0;
    list-style: none;
  }
  .lab-rail ol a {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-decoration: none;
    border: var(--hairline) solid transparent;
    border-radius: var(--radius);
    transition:
      color var(--duration) var(--ease),
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }
  .lab-rail ol a:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }
  .lab-rail ol a[aria-current="page"] {
    color: var(--color-accent);
    background: var(--color-accent-soft);
    border-color: var(--color-accent);
  }
  /* The lab's name, shown beside its key on hover or keyboard focus */
  .lab-rail-tip {
    position: absolute;
    top: 50%;
    left: calc(100% + var(--space-3));
    padding: var(--space-1) var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    white-space: nowrap;
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--hairline) solid var(--color-border);
    border-radius: var(--radius);
    opacity: 0;
    transform: translate(-4px, -50%);
    pointer-events: none;
    transition:
      opacity var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }
  .lab-rail ol a:hover .lab-rail-tip,
  .lab-rail ol a:focus-visible .lab-rail-tip {
    opacity: 1;
    transform: translate(0, -50%);
  }

  /* Top bar: solid, so nothing scrolls through it */
  .lab-main {
    min-width: 0;
  }
  .lab-bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    gap: var(--space-6);
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    height: var(--bar-h);
    padding: 0 var(--space-8);
    background: var(--color-bg);
    border-bottom: var(--hairline) solid var(--color-border);
  }
  .lab-bar-title {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    min-width: 0;
  }
  .lab-bar-number,
  .lab-bar-week {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .lab-bar-number {
    color: var(--color-accent);
  }
  h1 {
    overflow: hidden;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .lab-bar-tools {
    display: flex;
    flex: none;
    gap: var(--space-4);
    align-items: center;
  }
  .lab-stepper {
    display: flex;
    gap: var(--space-1);
  }
  .lab-stepper > * {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    color: var(--color-text);
    border: var(--hairline) solid var(--color-border);
    border-radius: var(--radius);
    transition: border-color var(--duration) var(--ease);
  }
  .lab-stepper a:hover {
    border-color: var(--color-border-strong);
  }
  .lab-stepper span {
    color: var(--color-border-strong);
  }

  /* Page: the objective, the bench, the notes */
  .lab-page {
    max-width: none;
    padding: var(--space-6) var(--space-8) var(--space-24);
  }
  .lab-objective {
    max-width: 52rem;
    margin: 0 0 var(--space-6);
    color: var(--color-muted);
  }
  /* The bench's control rail stays in view under the bar while the results scroll */
  .lab-bench :global(.controls) {
    position: sticky;
    top: calc(var(--bar-h) + var(--space-4));
  }

  /* Lab sheet: a drawer from the right holding the sheet's notes, numbered like the steps */
  .lab-sheet-toggle {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    height: 32px;
    padding: 0 var(--space-3);
    font: 500 var(--text-sm) / 1 var(--font-sans);
    color: var(--color-text);
    background: transparent;
    border: var(--hairline) solid var(--color-border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color var(--duration) var(--ease);
  }
  .lab-sheet-toggle:hover {
    border-color: var(--color-border-strong);
  }
  .lab-sheet {
    position: fixed;
    inset: 0 0 0 auto;
    box-sizing: border-box;
    width: min(32rem, 100vw);
    height: 100svh;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    color: var(--color-text);
    background: var(--color-surface);
    border: 0;
    border-left: var(--hairline) solid var(--color-border);
    opacity: 0;
    transform: translateX(var(--space-6));
    transition:
      opacity var(--duration-panel) var(--ease),
      transform var(--duration-panel) var(--ease),
      overlay var(--duration-panel) allow-discrete,
      display var(--duration-panel) allow-discrete;
  }
  .lab-sheet:popover-open {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .lab-sheet:popover-open {
      opacity: 0;
      transform: translateX(var(--space-6));
    }
  }
  .lab-sheet::backdrop {
    background: rgb(0 0 0 / 0.5);
  }
  .lab-sheet-head {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    height: var(--bar-h);
    padding: 0 var(--space-4) 0 var(--space-6);
    background: var(--color-surface);
    border-bottom: var(--hairline) solid var(--color-border);
  }
  .lab-sheet-head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
  }
  .lab-sheet-head h2 span {
    margin-left: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
  }
  .lab-sheet-close {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    color: var(--color-text);
    background: transparent;
    border: var(--hairline) solid var(--color-border);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .lab-sheet-close:hover {
    border-color: var(--color-border-strong);
  }
  .lab-notes {
    padding: var(--space-6);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .lab-notes :global(h2) {
    margin: var(--space-8) 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-accent);
  }
  .lab-notes :global(h2:first-child) {
    margin-top: 0;
  }
  .lab-notes :global(ul),
  .lab-notes :global(ol) {
    margin: 0;
    padding-left: var(--space-5);
  }
  .lab-notes :global(ol li::marker) {
    font-family: var(--font-mono);
    color: var(--color-accent);
  }
  .lab-notes :global(p) {
    margin: var(--space-3) 0 0;
    color: var(--color-muted);
  }
  .lab-notes :global(li) {
    margin-bottom: var(--space-2);
  }

  @media (max-width: 1023px) {
    .lab-bar-week {
      display: none;
    }
  }
  @media (max-width: 52rem) {
    .lab-bench :global(.controls) {
      position: static;
    }
  }

  /* Phone: the rail becomes a bar along the bottom, and the status drops out of the top bar */
  @media (max-width: 639px) {
    .lab-shell {
      grid-template-columns: minmax(0, 1fr);
    }
    .lab-rail {
      position: fixed;
      inset: auto 0 0;
      flex-direction: row;
      justify-content: center;
      gap: var(--space-2);
      height: auto;
      padding: var(--space-2) var(--space-3) calc(var(--space-2) + env(safe-area-inset-bottom));
      border-top: var(--hairline) solid var(--color-border);
      border-right: 0;
    }
    .lab-rail-home {
      width: 36px;
      height: 36px;
      border-bottom: 0;
    }
    .lab-rail ol {
      flex-direction: row;
      gap: 2px;
      padding: 0 0 0 var(--space-2);
      border-top: 0;
      border-left: var(--hairline) solid var(--color-border);
    }
    .lab-rail ol a {
      width: 36px;
      height: 36px;
    }
    .lab-rail-tip {
      display: none;
    }
    .lab-bar {
      padding: 0 var(--space-4);
    }
    .lab-bar-tools :global(.badge) {
      display: none;
    }
    .lab-sheet-toggle {
      justify-content: center;
      width: 32px;
      padding: 0;
    }
    .lab-sheet-label {
      display: none;
    }
    .lab-page {
      padding: var(--space-5) var(--space-4) calc(var(--space-24) + 56px);
    }
  }
</style>
